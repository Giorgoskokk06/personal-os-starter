# Copy to .env and fill in your own credentials. Never commit .env.

# Supabase / PostgreSQL (PostgREST)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: Gemini Embedding API (768-dim halfvec embeddings)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Outbound-Only Telegram Alerts (never required for offline tests)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Drive OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: Comma-separated private markers checked by scripts/audit_public.py
# PERSONAL_OS_PRIVATE_MARKERS=YourName,PrivateOrg,InternalProject
