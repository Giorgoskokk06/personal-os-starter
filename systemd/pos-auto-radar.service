[Unit]
Description=Personal OS Daily Multi-Perspective Macro & Geopolitical Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal-os-starter
EnvironmentFile=-%h/personal-os-starter/.env
ExecStart=/usr/bin/env python3 -m src.intel_radar --briefing
